<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Style src="../Styles/JoinByBrowsingCartoon.uss" />
    <ui:Template name="CurrentSession" src="project://database/Assets/UI/UXML/CurrentSessionCartoon.uxml"/>
    <ui:Template name="SessionBrowser" src="project://database/Assets/UI/UXML/SessionBrowserCartoon.uxml"/>
    <ui:VisualElement name="LobbyHudWrapper" class="lobby-hud-wrapper" style="display: none; opacity: 0;">
        <ui:VisualElement data-source="project://database/Assets/Blocks/MultiplayerSession/Settings/SessionSettings.asset?fileID=11400000&amp;guid=0bf4e1684added44da254017c7fc41b2&amp;type=2#SessionSettings" name="MainContainer" class="lobby-main-container">
            <ui:VisualElement name="LeftColumn" class="lobby-left-column">
                <ui:Instance template="SessionBrowser"/>
            </ui:VisualElement>
            <ui:VisualElement name="LoadingRoomCard" class="blocks-modal lobby-loading-card" style="display: none;">
                <ui:VisualElement class="lobby-loading-body">
                    <ui:VisualElement class="lobby-loading-spinner-row">
                        <ui:VisualElement name="loading-dot-0" class="lobby-loading-dot"/>
                        <ui:VisualElement name="loading-dot-1" class="lobby-loading-dot"/>
                        <ui:VisualElement name="loading-dot-2" class="lobby-loading-dot"/>
                    </ui:VisualElement>
                    <ui:Label text="Carregando..." name="loading-room-title" class="lobby-loading-title"/>
                    <ui:Label text="Conectando à sala..." name="loading-room-subtitle" class="lobby-loading-subtitle"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="RightColumn" class="lobby-right-column">
                <ui:Instance template="CurrentSession"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="LobbyCornerActions" class="lobby-corner-actions" picking-mode="Ignore">
            <ui:VisualElement name="menu-volume-box" class="menu-volume-box">
                <ui:Button name="btn-lobby-mute-sound" class="menu-mute-icon-btn" tooltip="Mutar / Desmutar áudio" focusable="false">
                    <ui:VisualElement name="menu-mute-icon" class="menu-mute-icon" picking-mode="Ignore" />
                </ui:Button>
                <ui:Slider name="menu-volume-slider" low-value="0" high-value="100" value="100" class="menu-volume-slider" />
                <ui:Label name="menu-volume-percent" text="100%" class="menu-volume-percent" />
            </ui:VisualElement>
            <ui:Button name="btn-lobby-quit-game" class="blocks-button cartoon-btn--red menu-quit-button" text="SAIR DO JOGO" />
        </ui:VisualElement>
        <ui:VisualElement name="QuitConfirmModal" class="quit-confirm-modal-backdrop" style="display: none;">
            <ui:VisualElement class="blocks-modal quit-confirm-card">
                <ui:VisualElement class="quit-confirm-header-ribbon">
                    <ui:Label text="SAIR DO JOGO" class="quit-confirm-header-title" />
                </ui:VisualElement>
                <ui:VisualElement class="quit-confirm-body">
                    <ui:Label text="Deseja realmente sair do jogo?" class="quit-confirm-message" />
                    <ui:Label text="Se estiver em uma sala ou partida, você será desconectado." class="quit-confirm-submessage" />
                    <ui:VisualElement class="quit-confirm-actions">
                        <ui:Button name="btn-quit-confirm-cancel" class="blocks-button cartoon-btn--blue quit-confirm-btn" text="NÃO, VOLTAR" />
                        <ui:Button name="btn-quit-confirm-ok" class="blocks-button cartoon-btn--red quit-confirm-btn" text="SIM, SAIR" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
